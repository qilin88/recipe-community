{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "recipe-community",
  "pages_build_output_dir": "./dist/pages",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "recipe-community-db",
      "database_id": "87b336fc-3037-47ba-87da-b4cb31906f62",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "recipe-community-images"
    }
  ],
  "account_id": "a0f93ac60027616b428454200d214d41"
}

{
  "name": "recipe-community",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "apps/web",
    "apps/mobile"
  ],
  "scripts": {
    "install:ci": "npm ci",
    "dev": "npm run dev:web --",
    "dev:web": "npm run dev --workspace @recipe/web --",
    "dev:mobile": "npm run start --workspace @recipe/mobile --",
    "android": "npm run android --workspace @recipe/mobile --",
    "ios": "npm run ios --workspace @recipe/mobile --",
    "build": "npm run build:web --",
    "build:web": "npm run build --workspace @recipe/web --",
    "build:pages": "npm run build:pages --workspace @recipe/web --",
    "preview:pages": "npm run preview:pages --workspace @recipe/web --",
    "deploy:pages": "npm run deploy:pages --workspace @recipe/web --",
    "test": "node --test tests/*.test.mjs && npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "typecheck": "npm run typecheck --workspaces"
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
